<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>MatchUP Remote Console</title>
    <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@700;900&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Pretendard', sans-serif; }
        body { background: #121316; color: #e0e0e0; padding: 12px; width: 460px; user-select: none; }

        /* 상단 메인 탭 */
        .tab-menu { display: flex; gap: 6px; margin-bottom: 10px; }
        .tab-btn { flex: 1; padding: 10px 0; background: #22242b; border: 1px solid #3a3d4a; color: #888; font-weight: 900; font-size: 14px; border-radius: 6px; cursor: pointer; text-align: center; transition: all 0.2s; }
        .tab-btn:hover { background: #2a2d37; color: #fff; }
        .tab-btn.active { background: #ff5722; color: #fff; border-color: #ff5722; box-shadow: 0 0 10px rgba(255, 87, 34, 0.4); }

        /* ACE 버튼 특별 강조 스타일 */
        .tab-btn-ace { border-color: #ff0055; color: #ff0055; }
        .tab-btn-ace:hover { background: rgba(255, 0, 85, 0.15); color: #fff; }
        .tab-btn-ace.active { background: linear-gradient(135deg, #ff0055, #ff5722) !important; color: #fff !important; border-color: #ff0055 !important; box-shadow: 0 0 15px rgba(255, 0, 85, 0.7) !important; }

        .panel { background: #1a1b20; border: 1px solid #2e3038; border-radius: 8px; padding: 10px; margin-bottom: 8px; }
        .panel-title { font-size: 13px; font-weight: 900; color: #ff5722; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }

        .input-row { display: flex; gap: 6px; margin-bottom: 6px; align-items: center; }
        input[type="text"] { background: #0f1013; border: 1px solid #3a3d4a; color: #fff; padding: 6px; border-radius: 4px; font-weight: 700; font-size: 13px; outline: none; }
        input[type="text"]:focus { border-color: #ff5722; }
        
        .score-box { display: flex; align-items: center; gap: 4px; background: #0f1013; padding: 2px 6px; border-radius: 4px; border: 1px solid #3a3d4a; }
        .score-val { width: 22px; text-align: center; font-size: 16px; font-weight: 900; color: #ff5722; }
        .btn-score { background: #2f3542; color: #fff; border: none; width: 20px; height: 20px; border-radius: 3px; cursor: pointer; font-weight: 900; }
        .btn-score:hover { background: #ff5722; }

        .btn-action { background: #2f3542; color: #fff; border: none; padding: 5px 8px; font-size: 11px; font-weight: 900; border-radius: 4px; cursor: pointer; }
        .btn-action.active { background: #ff5722; }
        .btn-reset { background: rgba(255, 87, 34, 0.15); color: #ff5722; border: 1px solid #ff5722; margin-left: 3px; }
        .btn-reset:hover { background: #ff5722; color: #fff; }

        .match-card { background: #0f1013; border: 1px solid #282a36; border-radius: 6px; padding: 8px 6px; margin-bottom: 5px; transition: border-color 0.2s; }
        .match-card.active-set { border-color: #ffffff; background: #161820; }
        .match-card.hidden-set { opacity: 0.4; }

        .match-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 11px; color: #888; }
        .set-title { font-weight: 900; color: #fff; display: flex; align-items: center; gap: 4px; }
        .ace-tag { color: #ff0055; font-weight: 900; font-size: 13px; letter-spacing: 0.5px; }

        .player-row { display: flex; gap: 3px; align-items: center; justify-content: space-between; }
        .race-select { background: #1a1b20; border: 1px solid #3a3d4a; color: #fff; font-size: 11px; padding: 4px 1px; border-radius: 3px; cursor: pointer; font-weight: 900; width: 68px; flex-shrink: 0; }
        .btn-win { background: #222; border: 1px solid #444; color: #aaa; padding: 4px 4px; font-size: 11px; border-radius: 3px; cursor: pointer; white-space: nowrap; flex-shrink: 0; }
        .btn-win.winner { background: #ff5722; color: #fff; border-color: #ff5722; }
        
        .p-input { width: 56px; text-align: center; flex-shrink: 0; }
        .map-input { width: 58px; text-align: center; flex-shrink: 0; }

        /* 방송 송출 ON/OFF 토글 버튼 스타일 */
        .btn-broadcast {
            width: 100%;
            padding: 10px 0;
            font-size: 14px;
            font-weight: 900;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }
        .btn-broadcast.on {
            background: #2ed573;
            color: #121316;
            box-shadow: 0 0 12px rgba(46, 213, 115, 0.4);
        }
        .btn-broadcast.off {
            background: #2b2d36;
            color: #ff4757;
            border: 1px solid #ff4757;
        }
    </style>
</head>
<body>

    <!-- 상단 탭 메뉴 -->
    <div class="tab-menu">
        <button id="tab-btn-set1" class="tab-btn active" onclick="switchTab('set1')">1Set</button>
        <button id="tab-btn-set2" class="tab-btn" onclick="switchTab('set2')">2Set</button>
        <button id="tab-btn-ace" class="tab-btn tab-btn-ace" onclick="switchTab('ace')">ACE</button>
    </div>

    <div class="panel">
        <div class="panel-title">
            <span id="console-header-title">1Set 스코어보드 제어</span>
            <div>
                <button id="btn-reset-score" class="btn-action btn-reset" onclick="resetOnlyScores()">🔄 점수 리셋</button>
                <button class="btn-action btn-reset" onclick="resetAllData()">💥 현재 탭 초기화</button>
            </div>
        </div>
        
        <!-- 방송 송출 ON/OFF 토글 버튼 (상단 이동) -->
        <button id="btn-broadcast-toggle" class="btn-broadcast on" onclick="toggleBroadcast()">
            방송송출 ON 🟢
        </button>

        <!-- ACE 탭 선택 시 숨겨지는 영역 -->
        <div id="league-title-section" class="input-row">
            <input type="text" id="league-title" value="" placeholder="" style="width: 100%;" oninput="saveAndSend()">
        </div>

        <div id="team-score-section" class="input-row" style="justify-content: space-between;">
            <input type="text" id="team-l" value="" placeholder="" style="width: 120px; text-align: right;" oninput="saveAndSend()">
            
            <div class="score-box">
                <button class="btn-score" onclick="changeScore('left', -1)">-</button>
                <span id="score-l" class="score-val">0</span>
                <button class="btn-score" onclick="changeScore('left', 1)">+</button>
            </div>
            
            <span style="font-weight: 900; color: #555;">:</span>

            <div class="score-box">
                <button class="btn-score" onclick="changeScore('right', -1)">-</button>
                <span id="score-r" class="score-val">0</span>
                <button class="btn-score" onclick="changeScore('right', 1)">+</button>
            </div>

            <input type="text" id="team-r" value="" placeholder="" style="width: 120px;" oninput="saveAndSend()">
        </div>

        <div class="input-row" style="margin-top: 8px; justify-content: space-between;">
            <button id="btn-glow" class="btn-action active" onclick="toggleGlow()">불빛 끄기 OFF</button>
            <div id="match-ctrl-btns">
                <button class="btn-action" onclick="hideLastMatch()">경기 숨기기 ↩</button>
                <button class="btn-action" onclick="showNextMatch()">다음 경기 공개 👁</button>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-title" id="match-list-title">매치업 목록</div>
        <div id="matches-container"></div>
    </div>

<script>
    const ROOM_TARGETS = {
        'set1': 'star-proleague-room-set1',
        'set2': 'star-proleague-room-set2',
        'ace': 'star-proleague-room-ace'
    };

    let currentTab = 'set1';
    let peer = null;
    let conns = { 'set1': null, 'set2': null, 'ace': null };
    let isGlowOn = true;
    let isBroadcastOn = true;
    let isLoading = false;

    function initPeer() {
        if (peer && !peer.destroyed) return;
        
        peer = new Peer();

        peer.on('open', () => {
            connectAllOverlays();
        });

        peer.on('error', () => {
            setTimeout(initPeer, 3000);
        });
    }

    function connectAllOverlays() {
        if (!peer || peer.destroyed) return;

        ['set1', 'set2', 'ace'].forEach(tab => {
            if (!conns[tab] || !conns[tab].open) {
                const targetRoom = ROOM_TARGETS[tab];
                const conn = peer.connect(targetRoom);

                conn.on('open', () => {
                    conns[tab] = conn;
                    sendTabData(tab);
                });

                conn.on('close', () => {
                    conns[tab] = null;
                });

                conn.on('error', () => {
                    conns[tab] = null;
                });
            }
        });
    }

    function switchTab(tabName) {
        currentTab = tabName;

        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.getElementById(`tab-btn-${tabName}`).classList.add('active');

        const tabTitleMap = { 'set1': '1Set 스코어보드', 'set2': '2Set 스코어보드', 'ace': 'ACE 에이스 결정전' };
        document.getElementById('console-header-title').innerText = `${tabTitleMap[tabName]} 제어`;

        const isAce = tabName === 'ace';

        const leagueSec = document.getElementById('league-title-section');
        const teamScoreSec = document.getElementById('team-score-section');
        const btnResetScore = document.getElementById('btn-reset-score');
        const ctrlBtns = document.getElementById('match-ctrl-btns');

        if (leagueSec) leagueSec.style.display = isAce ? 'none' : 'flex';
        if (teamScoreSec) teamScoreSec.style.display = isAce ? 'none' : 'flex';
        if (btnResetScore) btnResetScore.style.display = isAce ? 'none' : 'inline-block';
        if (ctrlBtns) ctrlBtns.style.display = isAce ? 'none' : 'block';

        renderMatches();
        loadSavedData();
    }

    function renderMatches() {
        const container = document.getElementById('matches-container');
        if (!container) return;
        container.innerHTML = '';

        const isAce = currentTab === 'ace';
        const totalMatches = isAce ? 1 : 9;

        for(let i = 1; i <= totalMatches; i++) {
            const card = document.createElement('div');
            card.className = `match-card ${i===1?'active-set':''}`;
            card.id = `card-${i}`;

            const setLabelHtml = isAce 
                ? `<span class="ace-tag">🔥 ACE</span>`
                : `<span class="set-title">
                    <input type="radio" name="active-set" value="${i}" ${i===1?'checked':''} onchange="setActiveSet(${i})">
                    ${i}세트 경기
                   </span>`;

            card.innerHTML = `
                <div class="match-header">
                    ${setLabelHtml}
                    <label style="cursor:pointer;">
                        <input type="checkbox" id="vis-${i}" ${i===1?'checked':''} onchange="saveAndSend()"> 화면 표시
                    </label>
                </div>
                <div class="player-row">
                    <select id="race-l-${i}" class="race-select" onchange="saveAndSend()">
                        <option value="color-default">선택안함</option>
                        <option value="color-zerg">저그</option>
                        <option value="color-terran">테란</option>
                        <option value="color-protoss">토스</option>
                    </select>
                    <input type="text" id="p-l-${i}" class="p-input" value="" placeholder="" oninput="saveAndSend()">
                    <button id="win-l-${i}" class="btn-win" onclick="setWinner(${i}, 'left')">🏆 승</button>
                    
                    <input type="text" id="map-${i}" class="map-input" value="" placeholder="" oninput="saveAndSend()">
                    
                    <button id="win-r-${i}" class="btn-win" onclick="setWinner(${i}, 'right')">🏆 승</button>
                    <input type="text" id="p-r-${i}" class="p-input" value="" placeholder="" oninput="saveAndSend()">
                    <select id="race-r-${i}" class="race-select" onchange="saveAndSend()">
                        <option value="color-default">선택안함</option>
                        <option value="color-zerg">저그</option>
                        <option value="color-terran">테란</option>
                        <option value="color-protoss">토스</option>
                    </select>
                </div>
            `;
            container.appendChild(card);
        }
    }

    function setActiveSet(setNum) {
        const totalMatches = currentTab === 'ace' ? 1 : 9;
        for(let i=1; i<=totalMatches; i++) {
            const card = document.getElementById(`card-${i}`);
            if(card) {
                if(i === setNum) card.classList.add('active-set');
                else card.classList.remove('active-set');
            }
        }
        saveAndSend();
    }

    function setWinner(setNum, pos) {
        const winL = document.getElementById(`win-l-${setNum}`);
        const winR = document.getElementById(`win-r-${setNum}`);
        const scoreL = document.getElementById('score-l');
        const scoreR = document.getElementById('score-r');

        const wasLeftWinner = winL.classList.contains('winner');
        const wasRightWinner = winR.classList.contains('winner');

        winL.classList.remove('winner');
        winR.classList.remove('winner');

        if(pos === 'left') {
            if(!wasLeftWinner) {
                winL.classList.add('winner');
                if(scoreL) scoreL.innerText = parseInt(scoreL.innerText || "0") + 1;
                if(wasRightWinner && scoreR) scoreR.innerText = Math.max(0, parseInt(scoreR.innerText || "0") - 1);
            } else {
                if(scoreL) scoreL.innerText = Math.max(0, parseInt(scoreL.innerText || "0") - 1);
            }
        } else {
            if(!wasRightWinner) {
                winR.classList.add('winner');
                if(scoreR) scoreR.innerText = parseInt(scoreR.innerText || "0") + 1;
                if(wasLeftWinner && scoreL) scoreL.innerText = Math.max(0, parseInt(scoreL.innerText || "0") - 1);
            } else {
                if(scoreR) scoreR.innerText = Math.max(0, parseInt(scoreR.innerText || "0") - 1);
            }
        }
        saveAndSend();
    }

    function changeScore(t, val) {
        const el = document.getElementById(t === 'left' ? 'score-l' : 'score-r');
        if (el) el.innerText = Math.max(0, parseInt(el.innerText || "0") + val);
        saveAndSend();
    }

    function toggleGlow() {
        isGlowOn = !isGlowOn;
        const btn = document.getElementById('btn-glow');
        if (btn) {
            btn.innerText = isGlowOn ? "불빛 끄기 OFF" : "불빛 켜기 ON";
            btn.className = `btn-action ${isGlowOn ? 'active' : ''}`;
        }
        saveAndSend();
    }

    function toggleBroadcast() {
        isBroadcastOn = !isBroadcastOn;
        updateBroadcastButtonUI();
        saveAndSend();
    }

    function updateBroadcastButtonUI() {
        const btn = document.getElementById('btn-broadcast-toggle');
        if (!btn) return;

        if (isBroadcastOn) {
            btn.innerText = "방송송출 ON 🟢";
            btn.className = "btn-broadcast on";
        } else {
            btn.innerText = "방송송출 OFF 🔴";
            btn.className = "btn-broadcast off";
        }
    }

    function showNextMatch() {
        if (currentTab === 'ace') return;
        for(let i=1; i<=9; i++) {
            const chk = document.getElementById(`vis-${i}`);
            if(chk && !chk.checked) {
                chk.checked = true;
                break;
            }
        }
        saveAndSend();
    }

    function hideLastMatch() {
        if (currentTab === 'ace') return;
        for(let i=9; i>=1; i--) {
            const chk = document.getElementById(`vis-${i}`);
            if(chk && chk.checked && i > 1) {
                chk.checked = false;
                break;
            }
        }
        saveAndSend();
    }

    function resetOnlyScores() {
        if(!confirm(`[${currentTab.toUpperCase()}] 점수와 승패 기록만 초기화할까요?`)) return;
        const scoreL = document.getElementById('score-l');
        const scoreR = document.getElementById('score-r');
        if (scoreL) scoreL.innerText = "0";
        if (scoreR) scoreR.innerText = "0";

        const totalMatches = currentTab === 'ace' ? 1 : 9;
        for(let i=1; i<=totalMatches; i++) {
            const winL = document.getElementById(`win-l-${i}`);
            const winR = document.getElementById(`win-r-${i}`);
            if(winL) winL.classList.remove('winner');
            if(winR) winR.classList.remove('winner');
        }
        saveAndSend();
    }

    function resetAllData() {
        if(!confirm(`현재 탭 [${currentTab.toUpperCase()}] 의 모든 설정을 초기화하시겠습니까?`)) return;
        localStorage.removeItem(`star_proleague_saved_data_${currentTab}`);
        switchTab(currentTab);
        saveAndSend();
    }

    function loadSavedData() {
        isLoading = true;

        const storageKey = `star_proleague_saved_data_${currentTab}`;
        const savedRaw = localStorage.getItem(storageKey);
        
        const leagueInput = document.getElementById('league-title');
        const teamLInput = document.getElementById('team-l');
        const teamRInput = document.getElementById('team-r');
        const scoreL = document.getElementById('score-l');
        const scoreR = document.getElementById('score-r');

        if (leagueInput) leagueInput.value = "";
        if (teamLInput) teamLInput.value = "";
        if (teamRInput) teamRInput.value = "";
        if (scoreL) scoreL.innerText = "0";
        if (scoreR) scoreR.innerText = "0";

        const totalMatches = currentTab === 'ace' ? 1 : 9;

        if (!savedRaw) {
            for(let i=1; i<=totalMatches; i++) {
                const pL = document.getElementById(`p-l-${i}`);
                const pR = document.getElementById(`p-r-${i}`);
                const map = document.getElementById(`map-${i}`);
                const raceL = document.getElementById(`race-l-${i}`);
                const raceR = document.getElementById(`race-r-${i}`);
                const winL = document.getElementById(`win-l-${i}`);
                const winR = document.getElementById(`win-r-${i}`);

                if (pL) pL.value = "";
                if (pR) pR.value = "";
                if (map) map.value = "";
                if (raceL) raceL.value = "color-default";
                if (raceR) raceR.value = "color-default";
                if (winL) winL.classList.remove('winner');
                if (winR) winR.classList.remove('winner');
            }
            isBroadcastOn = true;
            updateBroadcastButtonUI();
            isLoading = false;
            return;
        }

        try {
            const data = JSON.parse(savedRaw);

            if (data.leagueTitle !== undefined && leagueInput) leagueInput.value = data.leagueTitle;
            if (data.teamL !== undefined && teamLInput) teamLInput.value = data.teamL;
            if (data.teamR !== undefined && teamRInput) teamRInput.value = data.teamR;
            if (data.scoreL !== undefined && scoreL) scoreL.innerText = data.scoreL;
            if (data.scoreR !== undefined && scoreR) scoreR.innerText = data.scoreR;

            if (data.isGlowOn !== undefined) {
                isGlowOn = data.isGlowOn;
                const btn = document.getElementById('btn-glow');
                if (btn) {
                    btn.innerText = isGlowOn ? "불빛 끄기 OFF" : "불빛 켜기 ON";
                    btn.className = `btn-action ${isGlowOn ? 'active' : ''}`;
                }
            }

            if (data.isBroadcastOn !== undefined) {
                isBroadcastOn = data.isBroadcastOn;
                updateBroadcastButtonUI();
            } else {
                isBroadcastOn = true;
                updateBroadcastButtonUI();
            }

            if (data.matches && data.matches.length > 0) {
                const count = currentTab === 'ace' ? 1 : data.matches.length;
                for(let idx = 0; idx < count; idx++) {
                    const m = data.matches[idx];
                    if (!m) continue;
                    const i = idx + 1;

                    const visChk = document.getElementById(`vis-${i}`);
                    if (visChk) visChk.checked = m.visible;

                    const radios = document.querySelectorAll(`input[name="active-set"]`);
                    if (radios[idx] && m.active) {
                        radios[idx].checked = true;
                        setActiveSet(i);
                    }

                    const pL = document.getElementById(`p-l-${i}`);
                    const pR = document.getElementById(`p-r-${i}`);
                    const map = document.getElementById(`map-${i}`);
                    const raceL = document.getElementById(`race-l-${i}`);
                    const raceR = document.getElementById(`race-r-${i}`);

                    if (pL) pL.value = m.playerL || "";
                    if (pR) pR.value = m.playerR || "";
                    if (map) map.value = m.map || "";
                    if (raceL) raceL.value = m.raceL || "color-default";
                    if (raceR) raceR.value = m.raceR || "color-default";

                    const winL = document.getElementById(`win-l-${i}`);
                    const winR = document.getElementById(`win-r-${i}`);
                    if (winL) winL.classList.remove('winner');
                    if (winR) winR.classList.remove('winner');

                    if (m.winner === 'left' && winL) winL.classList.add('winner');
                    if (m.winner === 'right' && winR) winR.classList.add('winner');
                }
            }
        } catch(e) {
            console.error("데이터 로드 오류:", e);
        } finally {
            isLoading = false;
        }
    }

    function collectCurrentTabData() {
        const totalMatches = currentTab === 'ace' ? 1 : 9;
        const matches = [];

        for(let i=1; i<=totalMatches; i++) {
            const visChk = document.getElementById(`vis-${i}`);
            const isVis = visChk ? visChk.checked : true;
            const activeRadios = document.querySelectorAll(`input[name="active-set"]`);
            const isAct = currentTab === 'ace' ? true : (activeRadios[i-1] ? activeRadios[i-1].checked : false);
            
            const card = document.getElementById(`card-${i}`);
            if (card) {
                card.className = `match-card ${isAct?'active-set':''} ${!isVis?'hidden-set':''}`;
            }

            const winL = document.getElementById(`win-l-${i}`);
            const winR = document.getElementById(`win-r-${i}`);
            const isWinL = winL ? winL.classList.contains('winner') : false;
            const isWinR = winR ? winR.classList.contains('winner') : false;

            const pL = document.getElementById(`p-l-${i}`);
            const pR = document.getElementById(`p-r-${i}`);
            const map = document.getElementById(`map-${i}`);
            const raceL = document.getElementById(`race-l-${i}`);
            const raceR = document.getElementById(`race-r-${i}`);

            matches.push({
                visible: isVis,
                active: isAct,
                playerL: pL ? pL.value : "",
                playerR: pR ? pR.value : "",
                map: map ? map.value : "",
                raceL: raceL ? raceL.value : 'color-default',
                raceR: raceR ? raceR.value : 'color-default',
                winner: isWinL ? 'left' : (isWinR ? 'right' : 'none')
            });
        }

        const leagueEl = document.getElementById('league-title');
        const teamLEl = document.getElementById('team-l');
        const teamREl = document.getElementById('team-r');
        const scoreLEl = document.getElementById('score-l');
        const scoreREl = document.getElementById('score-r');

        return {
            leagueTitle: leagueEl ? leagueEl.value : "",
            teamL: teamLEl ? teamLEl.value : "",
            teamR: teamREl ? teamREl.value : "",
            scoreL: scoreLEl ? scoreLEl.innerText : "0",
            scoreR: scoreREl ? scoreREl.innerText : "0",
            isGlowOn: isGlowOn,
            isBroadcastOn: isBroadcastOn,
            matches: matches
        };
    }

    function saveAndSend() {
        if (isLoading) return;

        const data = collectCurrentTabData();
        localStorage.setItem(`star_proleague_saved_data_${currentTab}`, JSON.stringify(data));

        if(conns[currentTab] && conns[currentTab].open) {
            conns[currentTab].send(data);
        }
    }

    function sendTabData(tabName) {
        const savedRaw = localStorage.getItem(`star_proleague_saved_data_${tabName}`);
        if (savedRaw && conns[tabName] && conns[tabName].open) {
            try {
                conns[tabName].send(JSON.parse(savedRaw));
            } catch(e){}
        }
    }

    window.onload = () => {
        renderMatches();
        loadSavedData();
        initPeer();
    };

    setInterval(() => {
        connectAllOverlays();
    }, 3000);
</script>
</body>
</html>
